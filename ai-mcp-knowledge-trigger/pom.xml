<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xbk</groupId>
        <artifactId>ai-mcp-knowledge-study</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-mcp-knowledge-trigger</artifactId>
    <description>应用触发层模块，提供对外接口入口与请求响应编排</description>

    <dependencies>
        <!-- 依赖 application 模块 -->
        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 依赖 api 模块 -->
        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 依赖 types 模块 -->
        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-types</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Spring Boot Starter AOP (WebLogAspect 需要) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring AI OpenAI (for MCPServerCSDNJob) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Springdoc OpenAPI (Swagger) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- XXL-Job Core -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>2.4.1</version>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ai-mcp-knowledge-trigger</finalName>
    </build>

</project>
