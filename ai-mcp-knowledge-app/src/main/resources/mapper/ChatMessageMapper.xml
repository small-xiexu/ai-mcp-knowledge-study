<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.dao.IChatMessageDao">

    <resultMap id="ChatMessageMap" type="com.xbk.knowledge.infrastructure.dao.po.ChatMessagePO">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="model_id" property="modelId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insertMessage" parameterType="com.xbk.knowledge.infrastructure.dao.po.ChatMessagePO" useGeneratedKeys="true" keyProperty="id">
        insert into ai_chat_message (
            session_id,
            role,
            content,
            model_id,
            created_at
        ) values (
            #{sessionId},
            #{role},
            #{content},
            #{modelId},
            #{createdAt}
        )
    </insert>

    <select id="findPage" resultMap="ChatMessageMap">
        select
            id,
            session_id,
            role,
            content,
            model_id,
            created_at
        from ai_chat_message
        where session_id = #{sessionId}
        order by id asc
        limit #{pageSize} offset #{offset}
    </select>

    <select id="countBySessionId" resultType="long">
        select count(1)
        from ai_chat_message
        where session_id = #{sessionId}
    </select>

    <delete id="deleteBySessionId">
        delete from ai_chat_message
        where session_id = #{sessionId}
    </delete>

    <delete id="deleteBySessionUpdatedBefore">
        delete from ai_chat_message
        where session_id in (
            select id
            from ai_chat_session
            where updated_at &lt; #{updatedBefore}
        )
    </delete>

</mapper>
