<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.mapper.SysAuditEventMapper">

    <resultMap id="SysAuditEventMap" type="com.xbk.knowledge.domain.model.entity.SysAuditEvent">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_type" property="operatorType"/>
        <result column="event_type" property="eventType"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="action" property="action"/>
        <result column="request_id" property="requestId"/>
        <result column="source_ip" property="sourceIp"/>
        <result column="user_agent" property="userAgent"/>
        <result column="old_value" property="oldValue"/>
        <result column="new_value" property="newValue"/>
        <result column="result" property="result"/>
        <result column="error_message" property="errorMessage"/>
        <result column="cost_ms" property="costMs"/>
        <result column="occurred_at" property="occurredAt"/>
    </resultMap>

    <sql id="SysAuditEventColumns">
        id,
        tenant_id,
        operator_id,
        operator_type,
        event_type,
        resource_type,
        resource_id,
        action,
        request_id,
        source_ip,
        user_agent,
        old_value,
        new_value,
        result,
        error_message,
        cost_ms,
        occurred_at
    </sql>

    <insert id="insertEvent" parameterType="com.xbk.knowledge.domain.model.entity.SysAuditEvent"
            useGeneratedKeys="true" keyProperty="id">
        insert into sys_audit_event (
            tenant_id,
            operator_id,
            operator_type,
            event_type,
            resource_type,
            resource_id,
            action,
            request_id,
            source_ip,
            user_agent,
            old_value,
            new_value,
            result,
            error_message,
            cost_ms,
            occurred_at
        ) values (
            #{tenantId},
            #{operatorId},
            #{operatorType},
            #{eventType},
            #{resourceType},
            #{resourceId},
            #{action},
            #{requestId},
            #{sourceIp},
            #{userAgent},
            #{oldValue},
            #{newValue},
            #{result},
            #{errorMessage},
            #{costMs},
            #{occurredAt}
        )
    </insert>

    <select id="findPage" resultMap="SysAuditEventMap">
        select
        <include refid="SysAuditEventColumns"/>
        from sys_audit_event
        where tenant_id = #{tenantId}
        <if test="operatorId != null">
            and operator_id = #{operatorId}
        </if>
        <if test="eventType != null and eventType != ''">
            and event_type = #{eventType}
        </if>
        <if test="resourceType != null and resourceType != ''">
            and resource_type = #{resourceType}
        </if>
        <if test="result != null">
            and result = #{result}
        </if>
        order by occurred_at desc, id desc
        limit #{pageSize} offset #{offset}
    </select>

    <select id="count" resultType="long">
        select count(1)
        from sys_audit_event
        where tenant_id = #{tenantId}
        <if test="operatorId != null">
            and operator_id = #{operatorId}
        </if>
        <if test="eventType != null and eventType != ''">
            and event_type = #{eventType}
        </if>
        <if test="resourceType != null and resourceType != ''">
            and resource_type = #{resourceType}
        </if>
        <if test="result != null">
            and result = #{result}
        </if>
    </select>

</mapper>
