<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.dao.IMcpToolBindingDao">

    <resultMap id="McpToolBindingMap" type="com.xbk.knowledge.infrastructure.dao.po.McpToolBindingPO">
        <id column="id" property="id"/>
        <result column="gateway_id" property="gatewayId"/>
        <result column="tool_id" property="toolId"/>
        <result column="bind_type" property="bindType"/>
        <result column="bind_target_id" property="bindTargetId"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insertToolBinding" parameterType="com.xbk.knowledge.infrastructure.dao.po.McpToolBindingPO" useGeneratedKeys="true" keyProperty="id">
        insert into mcp_tool_binding (
            gateway_id,
            tool_id,
            bind_type,
            bind_target_id,
            enabled,
            created_at,
            updated_at
        ) values (
            #{gatewayId},
            #{toolId},
            #{bindType},
            #{bindTargetId},
            #{enabled},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <update id="updateToolBinding" parameterType="com.xbk.knowledge.infrastructure.dao.po.McpToolBindingPO">
        update mcp_tool_binding
        set gateway_id = #{gatewayId},
            tool_id = #{toolId},
            bind_type = #{bindType},
            bind_target_id = #{bindTargetId},
            enabled = #{enabled},
            updated_at = #{updatedAt}
        where id = #{id}
    </update>

    <delete id="deleteToolBindingById">
        delete from mcp_tool_binding
        where id = #{id}
    </delete>

    <delete id="deleteToolBindingByToolId">
        delete from mcp_tool_binding
        where tool_id = #{toolId}
    </delete>

    <select id="findByBindTypeAndTargetId" resultMap="McpToolBindingMap">
        select
            id,
            gateway_id,
            tool_id,
            bind_type,
            bind_target_id,
            enabled,
            created_at,
            updated_at
        from mcp_tool_binding
        where 1 = 1
          and bind_type = #{bindType}
          and bind_target_id = #{bindTargetId}
    </select>

    <select id="findByToolId" resultMap="McpToolBindingMap">
        select
            id,
            gateway_id,
            tool_id,
            bind_type,
            bind_target_id,
            enabled,
            created_at,
            updated_at
        from mcp_tool_binding
        where tool_id = #{toolId}
    </select>

</mapper>
