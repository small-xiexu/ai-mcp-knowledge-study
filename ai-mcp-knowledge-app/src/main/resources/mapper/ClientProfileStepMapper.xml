<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.dao.IClientProfileStepDao">

    <resultMap id="ClientProfileStepMap" type="com.xbk.knowledge.infrastructure.dao.po.ClientProfileStepPO">
        <id column="id" property="id"/>
        <result column="client_profile_id" property="clientProfileId"/>
        <result column="sequence_no" property="sequenceNo"/>
        <result column="step_name" property="stepName"/>
        <result column="model_id" property="modelId"/>
        <result column="system_prompt" property="systemPrompt"/>
        <result column="enable_tools" property="enableTools"/>
        <result column="allowed_tool_keys_json" property="allowedToolKeysJson"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="listByClientProfileId" resultMap="ClientProfileStepMap">
        select
            id,
            client_profile_id,
            sequence_no,
            step_name,
            model_id,
            system_prompt,
            enable_tools,
            allowed_tool_keys_json,
            created_at,
            updated_at
        from ai_client_profile_step
        where client_profile_id = #{clientProfileId}
        order by sequence_no asc, id asc
    </select>

    <delete id="deleteByClientProfileId">
        delete from ai_client_profile_step
        where client_profile_id = #{clientProfileId}
    </delete>

    <insert id="batchInsert">
        insert into ai_client_profile_step (
            client_profile_id,
            sequence_no,
            step_name,
            model_id,
            system_prompt,
            enable_tools,
            allowed_tool_keys_json,
            created_at,
            updated_at
        ) values
        <foreach collection="steps" item="it" separator=",">
            (
                #{it.clientProfileId},
                #{it.sequenceNo},
                #{it.stepName},
                #{it.modelId},
                #{it.systemPrompt},
                #{it.enableTools},
                #{it.allowedToolKeysJson},
                #{it.createdAt},
                #{it.updatedAt}
            )
        </foreach>
    </insert>

</mapper>
