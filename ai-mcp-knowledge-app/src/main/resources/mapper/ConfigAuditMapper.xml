<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.mapper.ConfigAuditMapper">

    <!-- 配置审计结果映射 -->
    <resultMap id="ConfigAuditMap" type="com.xbk.knowledge.domain.model.entity.ConfigAudit">
        <id column="id" property="id"/>
        <result column="org_id" property="orgId"/>
        <result column="table_name" property="tableName"/>
        <result column="record_id" property="recordId"/>
        <result column="operation" property="operation"/>
        <result column="old_value" property="oldValue"/>
        <result column="new_value" property="newValue"/>
        <result column="operator" property="operator"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 写入配置审计记录 -->
    <insert id="insertConfigAudit" parameterType="com.xbk.knowledge.domain.model.entity.ConfigAudit"
            useGeneratedKeys="true" keyProperty="id">
        insert into ai_config_audit (
            org_id,
            table_name,
            record_id,
            operation,
            old_value,
            new_value,
            operator,
            created_at
        ) values (
            #{orgId},
            #{tableName},
            #{recordId},
            #{operation},
            #{oldValue},
            #{newValue},
            #{operator},
            #{createdAt}
        )
    </insert>

    <!-- 按条件分页查询审计，排序字段由上层白名单解析 -->
    <select id="findByConditions" resultMap="ConfigAuditMap">
        select
            id,
            org_id,
            table_name,
            record_id,
            operation,
            old_value,
            new_value,
            operator,
            created_at
        from ai_config_audit
        <where>
            <if test="tableName != null">
                and table_name = #{tableName}
            </if>
        </where>
        order by ${sortField} ${sortOrder}
        limit #{pageSize} offset #{offset}
    </select>

    <!-- 统计审计记录总数（用于分页） -->
    <select id="countByConditions" resultType="long">
        select count(1)
        from ai_config_audit
        <where>
            <if test="tableName != null">
                and table_name = #{tableName}
            </if>
        </where>
    </select>

    <!-- 查询所有可用表名 -->
    <select id="listTableNames" resultType="string">
        select distinct table_name
        from ai_config_audit
        where table_name is not null
        order by table_name
    </select>

</mapper>
