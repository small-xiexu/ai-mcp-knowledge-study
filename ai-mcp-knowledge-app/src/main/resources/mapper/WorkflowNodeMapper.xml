<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xbk.knowledge.infrastructure.dao.IWorkflowNodeDao">

    <resultMap id="WorkflowNodeMap" type="com.xbk.knowledge.infrastructure.dao.po.WorkflowNodePO">
        <id column="id" property="id"/>
        <result column="workflow_version_id" property="workflowVersionId"/>
        <result column="node_key" property="nodeKey"/>
        <result column="node_type" property="nodeType"/>
        <result column="node_name" property="nodeName"/>
        <result column="config_json" property="configJson"/>
        <result column="position_x" property="positionX"/>
        <result column="position_y" property="positionY"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insertNode" parameterType="com.xbk.knowledge.infrastructure.dao.po.WorkflowNodePO"
            useGeneratedKeys="true" keyProperty="id">
        insert into workflow_node (
            config_json, position_x, position_y,
            created_at, updated_at
        ) values (
            #{configJson}, #{positionX}, #{positionY},
            #{createdAt}, #{updatedAt}
        )
    </insert>

    <delete id="deleteByVersion">
        delete from workflow_node
        where 1 = 1
          and workflow_version_id = #{workflowVersionId}
    </delete>

    <select id="listNodes" resultMap="WorkflowNodeMap">
        select
            config_json, position_x, position_y,
            created_at, updated_at
        from workflow_node
        where 1 = 1
          and workflow_version_id = #{workflowVersionId}
        order by id asc
    </select>

</mapper>

