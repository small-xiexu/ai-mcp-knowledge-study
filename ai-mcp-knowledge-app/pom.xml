<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xbk</groupId>
        <artifactId>ai-mcp-knowledge-study</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-mcp-knowledge-app</artifactId>
    <description>应用核心模块，负责业务编排与基础设施集成</description>

    <dependencies>
        <!--
            Spring Boot Web Starter
            提供 Web 应用核心功能：内嵌 Tomcat、Spring MVC、RESTful 支持
            是构建 Web 服务的基础依赖
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus Extension (Spring 集成支持) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MyBatis-Spring (兼容 Spring Boot 3.x) -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>${mybatis-spring.version}</version>
        </dependency>

        <!-- Druid 数据库连接池（Spring Boot 3） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.23</version>
        </dependency>

        <!--
            Spring Boot Test Starter
            提供测试支持：JUnit 5、Mockito、Spring Test、AssertJ 等
            仅在测试阶段使用，不会打包到生产环境
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring AI OpenAI Starter
            集成 OpenAI API（GPT-3.5/GPT-4/GPT-4o 等模型）
            提供：ChatClient、Embedding、Image Generation 等功能
            支持 OpenAI 兼容的第三方 API（如 DeepSeek、智谱等）
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            Spring AI Ollama Starter
            集成本地 Ollama 服务，支持运行开源大模型
            如：Llama、Mistral、Qwen、DeepSeek 等
            适用于私有化部署、离线场景、降低 API 成本
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
            Spring AI Google Gemini 核心依赖（非 Starter）
            通过自定义配置类管理 Google GenAI Client
            支持：gemini-2.0-flash、gemini-1.5-pro、gemini-3-pro-high 等
            支持 Function Calling（工具调用）功能
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-google-genai</artifactId>
        </dependency>

        <!--
            Spring AI MCP Server Starter
            MCP (Model Context Protocol) 服务端实现
            将本应用作为 MCP Server，对外暴露 Tools/Resources/Prompts
            供 Claude Desktop、Cursor 等 MCP Client 调用
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>

        <!--
            Spring AI MCP Client (WebFlux) Starter
            MCP 客户端实现，基于 WebFlux 响应式编程
            用于连接外部 MCP Server，调用其暴露的 Tools
            支持 SSE (Server-Sent Events) 传输协议
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client-webflux</artifactId>
        </dependency>

        <!--
            Spring AI Tika Document Reader
            基于 Apache Tika 的文档解析器
            支持读取：PDF、Word、Excel、PPT、HTML、TXT 等多种格式
            将文档内容转换为可供 AI 处理的文本/Document 对象
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <!--
            结巴中文分词 (Jieba Analysis)
            高性能中文分词库，支持精确模式/全模式/搜索引擎模式
            用于中文文本的分词处理，提升中文 RAG 检索效果
        -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>

        <!--
            Spring AI PGVector Store
            基于 PostgreSQL + pgvector 扩展的向量数据库集成
            用于存储和检索文档 Embedding 向量
            是 RAG (检索增强生成) 应用的核心组件
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!--
            Lombok
            Java 代码简化工具，通过注解自动生成样板代码
            提供：@Data、@Getter、@Setter、@Slf4j、@Builder 等
            编译时生成代码，不增加运行时开销
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!--
            Alibaba FastJSON
            高性能 JSON 处理库
            用于：API 响应序列化、配置文件解析、数据转换等
        -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>

        <!-- H2 Database (测试用内存数据库) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-types</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.xbk</groupId>
            <artifactId>ai-mcp-knowledge-trigger</artifactId>
            <version>${project.version}</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>ai-mcp-knowledge-app</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/**</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/**</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <skipTests>false</skipTests>
                    <testFailureIgnore>false</testFailureIgnore>
                    <excludedGroups>integration</excludedGroups>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.4.3</version>
                <configuration>
                    <mainClass>com.xbk.knowledge.Application</mainClass>
                    <layout>JAR</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
